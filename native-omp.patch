+import { afterEach, beforeEach, describe, expect, it, spyOn, vi } from "bun:test";
+import { AsyncResource } from "node:async_hooks";
+import { setImmediate } from "node:timers/promises";
+import { Agent, type AgentMessage } from "@oh-my-pi/pi-agent-core";
+import { createMockModel } from "@oh-my-pi/pi-ai/providers/mock";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { ExtensionRuntime, loadExtensionFromFactory } from "@oh-my-pi/pi-coding-agent/extensibility/extensions/loader";
+import { ExtensionRunner } from "@oh-my-pi/pi-coding-agent/extensibility/extensions/runner";
+import { AgentSession } from "@oh-my-pi/pi-coding-agent/session/agent-session";
+import { AuthStorage } from "@oh-my-pi/pi-coding-agent/session/auth-storage";
+import { convertToLlm } from "@oh-my-pi/pi-coding-agent/session/messages";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { SessionMemory } from "@oh-my-pi/pi-coding-agent/session/session-memory";
+import { SessionProviderBoundary } from "@oh-my-pi/pi-coding-agent/session/session-provider-boundary";
+import { cfgRetryUsageAwareFallback, cfgRetryUsageReservePolicy } from "@oh-my-pi/pi-coding-agent/session/settings";
+import { EventBus } from "@oh-my-pi/pi-coding-agent/utils/event-bus";
+import { TempDir } from "@oh-my-pi/pi-utils";
+
+const notice = { customType: "old-monitor-notice", content: "LANE_WATCH_READY old-session", display: true };
+const seed = { customType: "reload-fixture-seed", content: "original fixture transcript", display: true };
+
+// Exercise real AgentSession transitions, normalization and persistence. Barriers
+// order existing awaits; only the model provider is local, with no network calls.
+describe("AgentSession next-turn session ownership", () => {
+	let directory: TempDir;
+	let auth: AuthStorage;
+	let agent: Agent;
+	let session: AgentSession;
+	let manager: SessionManager;
+	let streamCalls: number;
+	let beforeSwitch: (() => Promise<{ cancel: boolean } | undefined>) | undefined;
+	let beforeAgentStart: (() => Promise<void>) | undefined;
+	let providerEntered: ReturnType<typeof Promise.withResolvers<void>> | undefined;
+	let releaseProvider: ReturnType<typeof Promise.withResolvers<void>> | undefined;
+
+	beforeEach(async () => {
+		directory = TempDir.createSync("@pi-next-turn-ownership-");
+		auth = await AuthStorage.create(":memory:");
+		auth.keys.setRuntime("openai", "test-key");
+		const mock = createMockModel({
+			provider: "openai",
+			id: "gpt-test",
+			responses: [{ content: ["Done"] }, { content: ["Done"] }],
+		});
+		streamCalls = 0;
+		beforeSwitch = undefined;
+		beforeAgentStart = undefined;
+		providerEntered = undefined;
+		releaseProvider = undefined;
+		agent = new Agent({
+			getApiKey: () => "test-key",
+			initialState: { model: mock.model, systemPrompt: ["Test"], tools: [], messages: [] },
+			convertToLlm,
+			streamFn: async (model, context, options) => {
+				streamCalls++;
+				providerEntered?.resolve();
+				if (releaseProvider) await releaseProvider.promise;
+				return mock.stream(model, context, options);
+			},
+		});
+		manager = SessionManager.create(directory.path(), directory.join("sessions"));
+		const settings = Settings.isolated({ "compaction.enabled": false, "todo.enabled": false });
+		settings.setModelRole("default", "openai/gpt-test");
+		const registry = new ModelRegistry(auth);
+		const runtime = new ExtensionRuntime();
+		const extension = await loadExtensionFromFactory(
+			api => {
+				api.on("session_before_switch", async () => beforeSwitch?.());
+				api.on("before_agent_start", async () => beforeAgentStart?.());
+			},
+			directory.path(),
+			new EventBus(),
+			runtime,
+			"session-ownership-regression",
+		);
+		session = new AgentSession({
+			agent,
+			sessionManager: manager,
+			settings,
+			modelRegistry: registry,
+			extensionRunner: new ExtensionRunner([extension], runtime, directory.path(), manager, registry),
+			toolRegistry: new Map(),
+			rebuildSystemPrompt: async () => ({ systemPrompt: ["Test"] }),
+		});
+	});
+
+	afterEach(async () => {
+		releaseProvider?.resolve();
+		vi.restoreAllMocks();
+		await session?.dispose();
+		auth?.close();
+		directory?.removeSync();
+	});
+
+	async function createTarget(content: string) {
+		const target = SessionManager.create(directory.path(), directory.join("sessions"));
+		target.appendMessage({ role: "user", content, timestamp: 1 });
+		await target.ensureOnDisk();
+		await target.flush();
+		const file = target.getSessionFile();
+		if (!file) throw new Error("Expected a persisted target session");
+		const id = target.getSessionId();
+		await target.close();
+		return { file, id };
+	}
+
+	function holdNormalization() {
+		const entered = Promise.withResolvers<void>();
+		const release = Promise.withResolvers<void>();
+		const original = SessionProviderBoundary.prototype.normalizeAgentMessageImages;
+		spyOn(SessionProviderBoundary.prototype, "normalizeAgentMessageImages").mockImplementation(async function <
+			T extends AgentMessage,
+		>(this: SessionProviderBoundary, message: T): Promise<T> {
+			const normalized = await original.bind(this)(message);
+			if (message.role === "custom" && message.customType === notice.customType) {
+				entered.resolve();
+				await release.promise;
+			}
+			return normalized;
+		});
+		return { entered: entered.promise, release: () => release.resolve() };
+	}
+
+	function noticeMessages() {
+		return agent.state.messages.filter(
+			message => message.role === "custom" && message.customType === notice.customType,
+		);
+	}
+
+	function noticeEntries() {
+		return manager
+			.getEntries()
+			.filter(entry => entry.type === "custom_message" && entry.customType === notice.customType);
+	}

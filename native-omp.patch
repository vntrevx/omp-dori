+	async function persistActiveJournal(): Promise<string> {
+		expect(await session.sendCustomMessage(seed)).toBe(false);
+		await manager.ensureOnDisk();
+		await manager.flush();
+		const file = manager.getSessionFile();
+		if (!file) throw new Error("Expected the active session's persisted journal");
+		return file;
+	}
+
+	async function readNoticeRows(file: string): Promise<unknown[]> {
+		await manager.flush();
+		const journal = await Bun.file(file).text();
+		const rows: unknown[] = journal.trimEnd().split("\n").map(line => JSON.parse(line));
+		return rows.filter(
+			row =>
+				typeof row === "object" &&
+				row !== null &&
+				"type" in row &&
+				row.type === "custom_message" &&
+				"customType" in row &&
+				row.customType === notice.customType,
+		);
+	}
+
+	it.each([
+		["unchanged reload", "nextTurn", false],
+		["reload parked before the generation bump", "nextTurn", false],
+		["reload parked before the generation bump", "append", false],
+		["changed replay at the same journal path", "nextTurn", false],
+		["unchanged reload that supersedes a wake", "nextTurn", true],
+	] as const)("settles custom delivery across %s (%s)", async (scenario, mode, triggerTurn) => {
+		const file = await persistActiveJournal();
+		const sessionId = manager.getSessionId();
+		const normalization = holdNormalization();
+		const hookEntered = Promise.withResolvers<void>();
+		const releaseHook = Promise.withResolvers<void>();
+		const parked = scenario === "reload parked before the generation bump";
+		if (parked) {
+			beforeSwitch = async () => {
+				hookEntered.resolve();
+				await releaseHook.promise;
+				return undefined;
+			};
+		}
+		const changed = scenario === "changed replay at the same journal path";
+		const changedContent = "modified fixture transcript";
+		let settled = false;
+		let transition: Promise<void> | undefined;
+		const delivery = session
+			.sendCustomMessage(notice, { deliverAs: mode === "append" ? undefined : mode, triggerTurn })
+			.then(result => {
+				settled = true;
+				return result;
+			});
+		try {
+			await normalization.entered;
+			if (changed) {
+				const journal = await Bun.file(file).text();
+				// Keep the file, header and entry IDs; only the replayed message changes.
+				const editedJournal = journal.replace(JSON.stringify(seed.content), JSON.stringify(changedContent));
+				expect(editedJournal).not.toBe(journal);
+				await Bun.write(file, editedJournal);
+			}
+			transition = session.reload();
+			if (parked) {
+				await hookEntered.promise;
+				normalization.release();
+				await setImmediate();
+				expect(settled).toBe(false);
+				expect(noticeMessages()).toEqual([]);
+				expect(await readNoticeRows(file)).toEqual([]);
+				releaseHook.resolve();
+			}
+			await transition;
+			normalization.release();
+			expect(await delivery).toBe(false);
+			expect(manager.getSessionFile()).toBe(file);
+			expect(manager.getSessionId()).toBe(sessionId);
+			if (changed) {
+				expect(agent.state.messages).toContainEqual(
+					expect.objectContaining({ customType: seed.customType, content: changedContent }),
+				);
+				expect(noticeMessages()).toEqual([]);
+				expect(await readNoticeRows(file)).toEqual([]);
+			} else {
+				expect(noticeMessages()).toEqual([expect.objectContaining({ content: notice.content })]);
+				expect(await readNoticeRows(file)).toEqual([expect.objectContaining({ content: notice.content })]);
+			}
+			expect(streamCalls).toBe(0);
+		} finally {
+			releaseHook.resolve();
+			normalization.release();
+			await Promise.allSettled([transition, delivery]);
+		}
+	});
+
+	it("holds an outside notice until rollback finishes reconciling the restored transcript", async () => {
+		const file = await persistActiveJournal();
+		const target = await createTarget("target rejected during switch");
+		const reconcileEntered = Promise.withResolvers<void>();
+		const releaseReconcile = Promise.withResolvers<void>();
+		const original = SessionMemory.prototype.resetContextForNewTranscript;
+		spyOn(SessionMemory.prototype, "resetContextForNewTranscript").mockImplementation(
+			async function (this: SessionMemory) {
+				await original.call(this);
+				if (manager.getSessionId() === target.id) throw new Error("target reset rejected");
+			},
+		);
+		session.setSessionSwitchReconciler(async () => {
+			reconcileEntered.resolve();
+			await releaseReconcile.promise;
+		});
+		const transition = session.switchSession(target.file).then(
+			value => ({ value }),
+			error => ({ error }),
+		);
+		let delivery: Promise<boolean> | undefined;
+		let settled = false;
+		try {
+			await reconcileEntered.promise;
+			expect(manager.getSessionFile()).toBe(file);
+			delivery = session.sendCustomMessage(notice, { deliverAs: "nextTurn" }).then(result => {
+				settled = true;
+				return result;
+			});
+			await setImmediate();
+			expect(settled).toBe(false);
+			expect(noticeMessages()).toEqual([]);
+			expect(await readNoticeRows(file)).toEqual([]);
+			releaseReconcile.resolve();
+			expect(await transition).toMatchObject({ error: { message: "target reset rejected" } });
+			expect(await delivery).toBe(false);
+			expect(noticeMessages()).toEqual([expect.objectContaining({ content: notice.content })]);
+			expect(await readNoticeRows(file)).toEqual([expect.objectContaining({ content: notice.content })]);
+			expect(streamCalls).toBe(0);
+		} finally {
+			releaseReconcile.resolve();
+			await Promise.allSettled([transition, delivery]);
+		}
+	});
+
+	it("keeps an in-flight user-authored wake passive when an unchanged reload aborts its start hook", async () => {
+		const file = await persistActiveJournal();
+		const startEntered = Promise.withResolvers<void>();
+		const releaseStart = Promise.withResolvers<void>();
+		beforeAgentStart = async () => {
+			startEntered.resolve();
+			await releaseStart.promise;
+		};
+		const delivery = session.sendCustomMessage(
+			{ ...notice, attribution: "user" },
+			{ deliverAs: "nextTurn", triggerTurn: true },
+		);
+		try {
+			await startEntered.promise;
+			await session.reload();
+			releaseStart.resolve();
+			expect(await delivery).toBe(false);
+			expect(noticeMessages()).toEqual([expect.objectContaining({ content: notice.content })]);
+			expect(await readNoticeRows(file)).toEqual([expect.objectContaining({ content: notice.content })]);
+			expect(streamCalls).toBe(0);
+		} finally {
+			releaseStart.resolve();
+			await Promise.allSettled([delivery]);
+		}
+	});
+
+	it("checks usage again when a custom wake's start hook updates the active model metadata", async () => {
+		cfgRetryUsageAwareFallback.set(session.settings, true);
+		cfgRetryUsageReservePolicy.set(session.settings, "fail-closed");
+		const originalModel = session.model;
+		if (!originalModel) throw new Error("Expected a local fixture model");
